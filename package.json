{
  "name": "@jji/ui",
  "version": "0.3.0",
  "description": "JJI 사이트(ne, mo, space) 공통 UI 컴포넌트 + 개발 도구",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JJI-dev/JJI-ui.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "jji-dev": "./bin/jji-dev.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "bin"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "tsup && cp src/styles.css dist/styles.css",
    "sync": "npm run build && node scripts/sync.mjs",
    "dev": "tsup --watch --onSuccess \"cp src/styles.css dist/styles.css && node scripts/sync.mjs\"",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "next": ">=14",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "next": "14.2.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0"
  }
}
